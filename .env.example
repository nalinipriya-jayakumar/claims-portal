# Copy to .env to override the local defaults in docker-compose.yml.
# .env is gitignored. Never commit real credentials.

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

CLAIMS_DB_NAME=claims
CLAIMS_DB_USER=claims_app
CLAIMS_DB_PASSWORD=change-me

NOTIFICATION_DB_NAME=notification
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=change-me

RABBITMQ_USER=claims
RABBITMQ_PASSWORD=change-me
